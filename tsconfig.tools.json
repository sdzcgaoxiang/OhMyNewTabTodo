{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "chrome", "vite/client"]
  },
  "include": [
    "tests/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
