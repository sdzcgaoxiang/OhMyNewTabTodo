{
  "name": "oh-my-new-tab-todo",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sdzcgaoxiang/OhMyNewTabTodo.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "node --import=tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts public '*.{js,jsx,ts,tsx,json}' index.html .github",
    "format:check": "prettier --check src tests scripts public '*.{js,jsx,ts,tsx,json}' index.html .github",
    "check": "npm run format:check && npm test && npm run build && npm run test:e2e",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
